<mvc:View
    xmlns:core="sap.ui.core"
    controllerName="com.northwind.project1.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.ui.layout.form"
>
    <Page id="page">
        <content>
            <Panel
                headerText="Northwind Products Inventory"
                expandable="true"
                class="sapUiMeduimMarginBeginEnd"
                width="auto"
            >
                <f:SimpleForm
                    layout="ResponsiveGridLayout"
                    labelSpanL="3"
                    emptySpanL="6"
                    labelSpanM="3"
                    emptySpanM="6"
                >
                    <core:Title text="Product Details" />
                    <Label text="Product ID" />
                    <Input
                        id="oIpProductId"
                        showValueHelp="true"
                        valueHelpRequest="onPressF4Help"
                    />
                </f:SimpleForm>
                <FlexBox justifyContent="End">
                    <Button
                        text="Go"
                        type="Emphasized"
                        class="sapUiTinyMarginEnd"
                        icon="sap-icon://accept"
                        press="onPressGo"
                    />
                    <Button
                        text="Reset"
                        type="Reject"
                        icon="sap-icon://reset"
                    />
                </FlexBox>
            </Panel>

            <Table
                id="idProductsTable"
                items="{oModel>/Products}"
                mode="SingleSelectLeft"
                class="sapUiMeduimMarginBeginEnd"
                width="auto"
            >
                <headerToolbar>
                    <Toolbar>
                        <Title text="Products Inventory" />
                        <ToolbarSpacer />
                    </Toolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="Product ID" />
                    </Column>
                    <Column>
                        <Text text="Product Name" />
                    </Column>
                    <Column>
                        <Text text="SupplierId" />
                    </Column>
                    <Column>
                        <Text text="CategoryID" />
                    </Column>
                    <Column>
                        <Text text="Qty/Unity" />
                    </Column>
                    <Column>
                        <Text text="Price" />
                    </Column>
                    <Column>
                        <Text text="Stock" />
                    </Column>
                    <Column>
                        <Text text="Units order" />
                    </Column>
                    <Column>
                        <Text text="Reorder Level" />
                    </Column>
                    <Column>
                        <Text text="Discontinued" />
                    </Column>
                </columns>
                <items>
                    <ColumnListItem
                        type="Navigation"
                        press="onPressrow"
                    >
                        <Text text="{oModel>ProductID}" />
                        <Text text="{oModel>ProductName}" />
                        <Text text="{oModel>SupplierID}" />
                        <Text text="{oModel>CategoryID}" />
                        <Text text="{oModel>QuantityPerUnit}" />
                        <Text text="{oModel>UnitPrice}" />
                        <Text text="{oModel>UnitsInStock}" />
                        <Text text="{oModel>UnitsOnOrder}" />
                        <Text text="{oModel>ReorderLevel}" />
                        <Text text="{oModel>Discontinued}" />
                    </ColumnListItem>
                </items>
            </Table>
        </content>
        <footer>
            <Bar>
                <contentRight>
                    <Button
                        text="Submit"
                        type="Default"
                        press="onSubmit"
                    />
                </contentRight>
            </Bar>
        </footer>
    </Page>
</mvc:View>
